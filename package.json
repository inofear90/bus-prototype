{
  "name": "bus-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "icons": "node scripts/build-icons.mjs",
    "dev": "vite",
    "build": "npm run tokens && tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "check:adhoc": "node scripts/check-adhoc.mjs",
    "verify": "npm run lint && npm run check:adhoc && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/google-sans": "^5.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript": "5.6",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
